# Copy this file to ".env" and adjust the values you need.
# Everything runs locally through Ollama - no API keys, no cloud.

# ----- Ollama (local) -----
OLLAMA_HOST=http://localhost:11434

# Vision model tag served by Ollama. llama3.2-vision is the default for this
# project. (qwen2.5vl:3b / qwen2.5vl:7b are good alternatives if your Ollama
# version cannot load llama3.2-vision.)
LLAMA_OCR_MODEL=llama3.2-vision

# Request timeout in seconds (vision models are slow to load on the first call).
LLAMA_OCR_TIMEOUT=300

# 0.0 = faithful transcription. Raise slightly only if output is too terse.
LLAMA_OCR_TEMPERATURE=0.0

# Optional: override the OCR system prompt (advanced).
# LLAMA_OCR_SYSTEM_PROMPT=...

# ----- Model storage on the D drive -----
# Ollama itself reads OLLAMA_MODELS (NOT this app). Set it before starting the
# Ollama server so models download to D: instead of C:. The easiest way is to
# run setup_d_drive.ps1 once. Manual equivalent on Windows:
#   setx OLLAMA_MODELS "D:\OllamaModels"
# then restart Ollama.
