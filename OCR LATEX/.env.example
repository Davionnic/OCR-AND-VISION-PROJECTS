# Copy this file to ".env" and adjust the values you need.

# Which backend to use: "ollama" (local, free) or "openai" (cloud API).
LATEX_OCR_BACKEND=ollama

# ----- Ollama (local) backend -----
OLLAMA_HOST=http://localhost:11434
# qwen2.5vl:3b is a strong, lightweight, currently-supported vision/OCR model
# that runs well on CPU. Use qwen2.5vl:7b for higher accuracy if you have RAM/GPU.
# NOTE: llama3.2-vision (mllama) is broken in recent Ollama (0.30.x) -
# see https://github.com/ollama/ollama/issues/16490 - so it is not the default.
OLLAMA_MODEL=qwen2.5vl:3b

# If Ollama runs out of disk on C:, store models elsewhere (set before starting
# the Ollama server), e.g. on Windows:  setx OLLAMA_MODELS "D:\OllamaModels"

# ----- OpenAI-compatible (cloud) backend -----
# Works with OpenAI, Groq, Together, OpenRouter, etc.
# Example for Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.2-90b-vision-preview
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Request timeout in seconds (vision models can be slow on first run).
LATEX_OCR_TIMEOUT=180
